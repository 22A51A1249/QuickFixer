# =====================================================================
# AI IT Support and Ticket Resolution System - Environment Configuration
# =====================================================================

# Google Gemini API Key (Required for online LLM inference)
# Obtain an API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (Recommended: gemini-2.0-flash for latest free tier)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1

# Embedding Model (HuggingFace local model - no paid API needed)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage & Paths
SQLITE_DB_PATH=data/tickets.db
CHECKPOINT_DB_PATH=data/checkpoints.db
VECTOR_INDEX_DIR=data/vector_store
KNOWLEDGE_BASE_DIR=data/knowledge_base

# RAG Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=4
SIMILARITY_SCORE_THRESHOLD=0.7

# Demo Mode & Fallbacks (Set to True to enable offline demonstration mock adapter when no key is set)
ENABLE_OFFLINE_DEMO_FALLBACK=true
